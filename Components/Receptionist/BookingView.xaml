<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Animal_Spa.Components.Receptionist.BookingView" mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="760" FontFamily="{StaticResource Baloo2}" Background="White" Loaded="BookingWorkflow_Loaded">
  <!-- Bỏ qua những thuộc tính hoặc thành phần thuộc nhóm d vì chúng chỉ phục vụ việc thiết kế giao diện -->
  <!-- Khai báo các thuộc tính style dùng chung -->
  <UserControl.Resources>
    <!-- Thuộc tính dùng chung cho các Button -->
    <Style x:Key="BookingButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="62"/>
      <Setter Property="MinWidth" Value="230"/>
      <Setter Property="FontSize" Value="25"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <!-- ControlTemplate tự thiết kế lại giao diện của Button -->
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="14">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <!-- Trigger thay đổi thuộc tính khi có điều kiện được đáp ứng -->
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Khai báo thuộc tính dùng chung cho các đối tượng dữ liệu -->
    <DataTemplate x:Key="CustomerOptionTemplate">
      <Grid Height="64">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="66"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="52" Height="52" Background="#EEF6FC" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Image Source="/Animal-Spa;component/Asset/ICON-COSTUMER.png" Width="45" Height="45" Stretch="Uniform"/>
        </Border>
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="27" FontWeight="ExtraBold" Foreground="#161616" VerticalAlignment="Center" Margin="8,0,0,0"/>
      </Grid>
    </DataTemplate>
    <!-- Thuộc tính dùng chung cho các ComboBox -->
    <Style x:Key="CustomerComboStyle" TargetType="ComboBox">
      <Setter Property="Height" Value="82"/>
      <Setter Property="FontSize" Value="27"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Foreground" Value="#161616"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D9ECF8"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="ItemTemplate" Value="{StaticResource CustomerOptionTemplate}"/>
      <Setter Property="MaxDropDownHeight" Value="270"/>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Height" Value="44"/>
      <Setter Property="Padding" Value="15,6"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#398DD0"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" CornerRadius="10" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="#D2DCE5"/>
                <Setter Property="Foreground" Value="#758596"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="InputBox" TargetType="TextBox">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="BorderBrush" Value="#B9D5E8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="InputCombo" TargetType="ComboBox">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Height" Value="42"/>
      <Setter Property="BorderBrush" Value="#B9D5E8"/>
    </Style>
  </UserControl.Resources>
  <!-- Viewbox phóng to hoặc thu nhỏ nội dung; Uniform giữ đúng tỷ lệ -->
  <TabControl x:Name="BookingTabs" Margin="10,0,10,0" Background="White">
    <TabItem Header="1. TẠO BOOKING" FontSize="20" FontWeight="Bold">
      <Viewbox Stretch="Uniform">
        <Grid Width="1770" Height="1120">
          <Border Width="1630" Height="1040" Background="#EEF6FC" BorderBrush="#A8C9E8" BorderThickness="2" CornerRadius="38" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="150"/>
                <RowDefinition Height="190"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="140"/>
                <RowDefinition Height="105"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#A8C9E8" CornerRadius="38,38,0,0">
                <Grid Margin="34,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                  </Grid.ColumnDefinitions>
                  <Image Source="/Animal-Spa;component/Asset/ICON-PET.png" Width="82" Height="82" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  <!-- StackPanel xếp đối tượng theo thứ tự -->
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="BOOKING" FontSize="40" FontWeight="ExtraBold" Foreground="#111111"/>
                    <TextBlock Text="Create and review customer booking" FontSize="22" Foreground="#202020" Margin="0,-4,0,0"/>
                  </StackPanel>
                  <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,6,0">
                    <Ellipse Width="28" Height="28" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,0,48,0"/>
                    <Ellipse Width="18" Height="18" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,34,12,0"/>
                    <Ellipse Width="14" Height="14" Fill="#4A8DD8" HorizontalAlignment="Right" Margin="0,6,2,0"/>
                  </Grid>
                </Grid>
              </Border>
              <Grid Grid.Row="1" Margin="34,24,34,16">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="820"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#A8C9E8" CornerRadius="26" Padding="24,12">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="48"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Customer" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Background="White" BorderBrush="#D9ECF8" BorderThickness="2" CornerRadius="22" Padding="4,0">
                      <ComboBox x:Name="CustomerComboBox" Style="{StaticResource CustomerComboStyle}" SelectedValuePath="Id" SelectionChanged="CustomerComboBox_SelectionChanged"/>
                      <!-- Giá trị được chọn của combobox lấy từ thuộc tính Id. -->
                    </Border>
                  </Grid>
                </Border>
              </Grid>
              <Border Grid.Row="2" Margin="34,0,34,0" Background="#DCEEF9" CornerRadius="28">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="112"/>
                    <RowDefinition Height="230"/>
                    <RowDefinition Height="82"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="#A8C9E8" CornerRadius="28,28,0,0">
                    <Grid Margin="20,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Image Source="/Animal-Spa;component/Asset/ICON-PET.png" Width="68" Height="68" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="BOOKING DETAIL" FontSize="34" FontWeight="ExtraBold"/>
                        <TextBlock Text="Service added to this booking" FontSize="21" Margin="0,-4,0,0"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <Grid Grid.Row="1" Margin="10,12,10,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                      <!-- Hiển thị danh sách đối tượng -->
                      <ItemsControl x:Name="BookingItemsControl" ItemsSource="{Binding BookingItems}" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemContainerStyle>
                          <!-- Thuộc tính dùng chung cho các ContentPresenter -->
                          <Style TargetType="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                          </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Height="96" Margin="0,0,0,10" Background="#C6E1F5" CornerRadius="22" HorizontalAlignment="Stretch">
                              <Grid Margin="14,0">
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="100"/>
                                  <ColumnDefinition Width="*"/>
                                  <ColumnDefinition Width="280"/>
                                  <ColumnDefinition Width="290"/>
                                  <ColumnDefinition Width="78"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="76" Height="76" Background="White" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                  <Image Source="{Binding ServiceIcon}" Width="68" Height="68" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,14,0">
                                  <TextBlock Text="{Binding ServiceName}" FontSize="29" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis"/>
                                  <TextBlock Text="{Binding AnimalSummary}" FontSize="21" Foreground="#262626" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="2" Height="60" Background="White" CornerRadius="22" Margin="8,0" VerticalAlignment="Center">
                                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image Source="/Animal-Spa;component/Asset/ICON-TIME.jpg" Width="36" Height="36" Stretch="Uniform" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Duration}" FontSize="23" VerticalAlignment="Center"/>
                                  </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Height="60" Background="#A8CFF0" CornerRadius="22" Margin="8,0" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding PriceText}" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="4" Width="58" Height="58" Background="White" BorderThickness="0" Cursor="Hand" Tag="{Binding}" Click="RemoveService_Click">
                                  <Button.Template>
                                    <!-- ControlTemplate tự thiết kế lại giao diện của Button -->
                                    <ControlTemplate TargetType="Button">
                                      <Border Background="{TemplateBinding Background}" CornerRadius="14">
                                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="31" Foreground="#111111" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                      </Border>
                                    </ControlTemplate>
                                  </Button.Template>
                                </Button>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="EmptyBookingText" Text="No service selected yet" FontSize="24" Foreground="#667788" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Grid>
                  <Grid Grid.Row="2" Margin="24,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TotalServicesText" Text="Total services: 0" FontSize="27" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Total:" FontSize="27" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                      <Border Background="#4EA6E8" CornerRadius="16" Padding="24,8">
                        <TextBlock x:Name="TotalPriceText" Text="0đ" FontSize="30" FontWeight="ExtraBold" Foreground="White"/>
                      </Border>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
              <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0">
                <Button Content="Cancel" Background="#D2D5D8" Style="{StaticResource BookingButtonStyle}" Margin="0,0,20,0" Click="Cancel_Click"/>
                <Button Content="Tiếp tục: ROOM &amp; STAFF" Background="#4EA6E8" Style="{StaticResource BookingButtonStyle}" Click="SaveBooking_Click"/>
              </StackPanel>
              <Border Grid.Row="3" Margin="34,12,34,0" Padding="22,12" Background="#D7ECFB" CornerRadius="22">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="3*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.ColumnSpan="4" Text="THÔNG TIN LỊCH HẸN (nhập trước khi chọn phòng &amp; nhân viên)" FontWeight="ExtraBold" FontSize="21" Margin="0,0,0,6"/>
                  <StackPanel Grid.Row="1" Margin="0,0,12,0">
                    <TextBlock Text="Tên thú cưng *" FontSize="18" FontWeight="Bold"/>
                    <TextBox x:Name="PetNameInput" FontSize="19" Height="48" Padding="9,5" BorderBrush="#90BADA" BorderThickness="1" ToolTip="Nhập tên thú cưng"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Ngày hẹn *" FontSize="18" FontWeight="Bold"/>
                    <DatePicker x:Name="BookingDateInput" Height="48" FontSize="18" BorderBrush="#90BADA"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="Giờ (HH:mm) *" FontSize="18" FontWeight="Bold"/>
                    <TextBox x:Name="BookingTimeInput" Text="09:00" FontSize="19" Height="48" Padding="9,5" BorderBrush="#90BADA" BorderThickness="1"/>
                  </StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="3">
                    <TextBlock Text="Ghi chú" FontSize="18" FontWeight="Bold"/>
                    <TextBox x:Name="BookingNoteInput" Height="48" FontSize="18" Padding="9,5" BorderBrush="#90BADA" BorderThickness="1"/>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </Border>
        </Grid>
      </Viewbox>
    </TabItem>
    <TabItem Header="2. DANH SÁCH / QUẢN LÝ" FontSize="20" FontWeight="Bold">
      <Border Background="#ECF6FC" BorderBrush="#A8C9E8" BorderThickness="2" CornerRadius="28" Padding="28" Margin="10,15,10,10" Loaded="BookingManagement_Loaded">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="650"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="DANH SÁCH &amp; QUẢN LÝ BOOKING" FontSize="30" FontWeight="ExtraBold" Foreground="#153850"/>
              <TextBlock Text="Tìm kiếm, xem chi tiết, xác nhận/hủy và chuyển đến ROOM &amp; STAFF để phân công." FontSize="16" Foreground="#42637C"/>
            </StackPanel>
            <Button Grid.Column="1" x:Name="RefreshButton" Content="Làm mới danh sách" Style="{StaticResource ActionButton}" Click="Refresh_Click"/>
          </Grid>
          <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Tìm kiếm:" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="#42637C" Margin="0,0,10,0"/>
              <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource InputBox}" ToolTip="Tìm theo mã booking, khách hàng, thú cưng hoặc dịch vụ" TextChanged="SearchBox_TextChanged"/>
            </Grid>
            <ComboBox x:Name="StatusFilter" Grid.Column="1" Style="{StaticResource InputCombo}" SelectionChanged="StatusFilter_SelectionChanged" Margin="0,0,12,0">
              <ComboBoxItem Content="Tất cả trạng thái" Tag="ALL" IsSelected="True"/>
              <ComboBoxItem Content="Chờ xác nhận" Tag="PENDING"/>
              <ComboBoxItem Content="Đã xác nhận" Tag="CONFIRMED"/>
              <ComboBoxItem Content="Đã check-in" Tag="CHECKED_IN"/>
              <ComboBoxItem Content="Hoàn thành" Tag="COMPLETED"/>
              <ComboBoxItem Content="Đã hủy" Tag="CANCELLED"/>
            </ComboBox>
            <TextBlock Grid.Column="2" x:Name="CountText" Text="0 booking" VerticalAlignment="Center" FontSize="15" Foreground="#42637C"/>
          </Grid>
          <Border Grid.Row="2" Background="White" CornerRadius="9" Padding="12,8" Margin="0,0,0,14">
            <TextBlock x:Name="FeedbackText" Text="Chọn một booking để xem chi tiết." FontSize="15" Foreground="#42637C" TextWrapping="Wrap"/>
          </Border>
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="52*"/>
              <ColumnDefinition Width="14"/>
              <ColumnDefinition Width="48*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="8">
              <DataGrid x:Name="BookingTable" ItemsSource="{Binding FilteredBookings}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5EDF3" Background="White" RowBackground="White" AlternatingRowBackground="#F4F9FD" BorderThickness="0" ColumnHeaderHeight="43" RowHeight="64" FontSize="15" SelectionChanged="BookingTable_SelectionChanged">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Mã" Width="85" Binding="{Binding BookingCode}"/>
                  <DataGridTextColumn Header="Thời gian" Width="136" Binding="{Binding BookingTimeText}"/>
                  <DataGridTextColumn Header="Khách / thú cưng" Width="*" Binding="{Binding CustomerPetLabel}"/>
                  <DataGridTemplateColumn Header="Trạng thái" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Border x:Name="StatusPill" Background="#E9EFF5" CornerRadius="9" Padding="7,5" Margin="1,10" HorizontalAlignment="Left">
                          <TextBlock x:Name="StatusLabel" Text="{Binding StatusLabel}" Foreground="#526477" FontWeight="Bold" FontSize="13"/>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding Status}" Value="PENDING">
                            <Setter TargetName="StatusPill" Property="Background" Value="#FFF0C8"/>
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="#95630E"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="CONFIRMED">
                            <Setter TargetName="StatusPill" Property="Background" Value="#D9F5E6"/>
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="#187948"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="CANCELLED">
                            <Setter TargetName="StatusPill" Property="Background" Value="#FCE2E2"/>
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="#B34242"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding Status}" Value="COMPLETED">
                            <Setter TargetName="StatusPill" Property="Background" Value="#DDEBFF"/>
                            <Setter TargetName="StatusLabel" Property="Foreground" Value="#315D99"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
            <Border Grid.Column="2" Background="White" CornerRadius="16" Padding="19">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock Text="CHI TIẾT BOOKING" FontSize="23" FontWeight="ExtraBold" Foreground="#183D59"/>
                  <TextBlock x:Name="DetailCode" Text="Chưa chọn booking" FontSize="19" FontWeight="Bold" Margin="0,8,0,4"/>
                  <TextBlock x:Name="DetailStatus" FontSize="16" Foreground="#187948" FontWeight="Bold"/>
                  <TextBlock x:Name="DetailCustomer" FontSize="16" Margin="0,12,0,0"/>
                  <TextBlock x:Name="DetailPet" FontSize="16" Margin="0,4,0,0"/>
                  <TextBlock x:Name="DetailTime" FontSize="16" Margin="0,4,0,0"/>
                  <TextBlock x:Name="DetailDuration" FontSize="16" Margin="0,4,0,0"/>
                  <TextBlock x:Name="DetailServices" FontSize="15" TextWrapping="Wrap" Margin="0,8,0,0"/>
                  <TextBlock x:Name="DetailNote" FontSize="14" Foreground="#677E91" TextWrapping="Wrap" Margin="0,5,0,0"/>
                  <WrapPanel Margin="0,18,0,5">
                    <Button x:Name="ConfirmButton" Content="Xác nhận booking" Background="#269266" Style="{StaticResource ActionButton}" Margin="0,0,10,8" Click="BookingConfirm_Click" IsEnabled="False"/>
                    <Button x:Name="CancelButton" Content="Hủy booking" Background="#CF5A5A" Style="{StaticResource ActionButton}" Margin="0,0,0,8" Click="BookingCancel_Click" IsEnabled="False"/>
                  </WrapPanel>
                  <Separator Margin="0,12" Background="#D4E6F0"/>
                  <TextBlock Text="PHÂN CÔNG SERVICE SESSION" FontSize="21" FontWeight="ExtraBold" Foreground="#183D59"/>
                  <TextBlock x:Name="SessionText" Text="Chọn booking CONFIRMED để phân công." FontSize="14" TextWrapping="Wrap" Margin="0,7,0,8"/>
                  <TextBlock x:Name="AvailabilityText" Foreground="#42637C" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,10"/>
                  <Button x:Name="AssignButton" Content="Chọn phòng &amp; nhân viên →" Style="{StaticResource ActionButton}" Background="#398DD0" HorizontalAlignment="Left" Margin="0,15,0,8" Click="BookingAssign_Click" IsEnabled="False"/>
                  <TextBlock Text="Phòng và nhân viên được chọn tại màn hình ROOM &amp; STAFF; không thể phân công ca trùng giờ." Foreground="#677E91" FontSize="13" TextWrapping="Wrap"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>
      </Border>
    </TabItem>
  </TabControl>
</UserControl>
